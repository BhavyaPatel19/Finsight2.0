# Copy to .env and fill in. Never commit .env.

# Required — sign JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=

# Comma-separated frontend origins allowed by CORS (default: Vite dev server)
# ALLOWED_ORIGINS=http://localhost:5173

# Optional — hosted LLM for RAG / insights (free key at https://console.groq.com).
# New Groq projects block every model until you enable it under Settings → Project → Limits.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # or openai/gpt-oss-20b (faster), qwen/qwen3.8-27b

# Optional — Cerebras serves the same models with a larger free quota (1M tokens/day); used by
# the eval runs (LLM_PROVIDER=cerebras) and as the auto fallback when no Groq key is set.
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b      # or qwen-3.8-27b

# Optional — local LLM via Ollama (used when GROQ_API_KEY is unset)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_NUM_CTX=8192          # RAG prompts are ~4k tokens; Ollama's default window truncates them
# LLM_PROVIDER=auto            # auto | groq | cerebras | ollama
#
# Pacing for free / trial tiers, so long eval runs wait instead of failing on 429s:
# LLM_TOKENS_PER_MINUTE=7000     # Groq free tier (8K TPM); Cerebras trial: 25000
# LLM_REQUESTS_PER_MINUTE=4      # Cerebras trial (5 RPM)
# LLM_RETRY_ATTEMPTS=8           # more patience for rate limits (default 5)

# Market data: auto | yfinance | zerodha  (auto = Zerodha for linked users, else free delayed yfinance)
# MARKET_DATA_PROVIDER=auto

# Optional — Zerodha Kite Connect for live broker data (paid; app works without it)
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
# ZERODHA_REDIRECT_URI=https://your-domain/zerodha/callback

# Needed only to download the sample corpus from SEC EDGAR (their policy: app name + contact email)
# EDGAR_USER_AGENT="FinSight research you@example.com"

# Optional
# DATABASE_URL=sqlite:///./finsight.db
# LOG_LEVEL=INFO
